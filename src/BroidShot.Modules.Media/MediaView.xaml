<UserControl x:Class="BroidShot.Modules.Media.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Medya indir" Style="{StaticResource PageHeading}" />
      <TextBlock Text="Bağlantıyı yapıştır, biçimi seç ve cihazına kaydet." Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14">
      <ToggleButton x:Name="DownloadTab" Content="İndir" Style="{StaticResource FilterChip}" core:ThemeAssist.Icon="&#xE896;" Tag="download" IsChecked="True" Click="PageChanged" />
      <ToggleButton x:Name="HistoryTab" Content="Geçmiş" Style="{StaticResource FilterChip}" core:ThemeAssist.Icon="&#xE81C;" Tag="history" Click="PageChanged" />
      <ToggleButton x:Name="SettingsTab" Content="Ayarlar" Style="{StaticResource FilterChip}" core:ThemeAssist.Icon="&#xE713;" Tag="settings" Click="PageChanged" />
    </WrapPanel>
    <ScrollViewer x:Name="DownloadPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

    <!-- First use: explicit consent before yt-dlp / ffmpeg are downloaded -->
    <Border x:Name="ConsentCard" Style="{StaticResource WarningBar}" Margin="0,0,0,16" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="İlk kullanım için araçları hazırla" Style="{StaticResource SectionHeading}" />
        <TextBlock x:Name="ConsentText" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,12"
                   Text="Araçlar GitHub'daki resmi sürümlerden (yt-dlp/yt-dlp, BtbN/FFmpeg-Builds) indirilir ve SHA-256 ile doğrulanır. yt-dlp, modül kullanıldıkça günde en fazla bir kez güncellenir." />
        <WrapPanel>
          <Button Content="İndir ve devam et" core:ThemeAssist.Icon="&#xE896;" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AcceptConsent" />
          <Button Content="Vazgeç" Style="{StaticResource SubtleButton}" Click="DeclineConsent" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Link -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Bağlantı" Style="{StaticResource SectionHeading}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="UrlBox" core:ThemeAssist.Placeholder="Video veya oynatma listesi bağlantısını yapıştır…" AutomationProperties.Name="Medya bağlantısı" KeyDown="UrlKeyDown" ToolTip="Video, ses veya oynatma listesi bağlantısı (http/https)" />
          <Button Grid.Column="1" Content="Yapıştır" core:ThemeAssist.Icon="&#xE77F;" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="PasteUrl" />
          <Button Grid.Column="2" x:Name="FetchButton" Content="Bilgi al" core:ThemeAssist.Icon="&#xE721;" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="FetchClicked" />
        </Grid>
        <ProgressBar x:Name="FetchProgress" IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="FetchStatus" Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <!-- Info + options -->
    <Border x:Name="InfoCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="176" Height="99" CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource ControlBrush}" Margin="0,0,16,0" ClipToBounds="True">
            <Grid><TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="{StaticResource IconSizeLarge}" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="Thumbnail" Stretch="UniformToFill" /></Grid>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="InfoTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock x:Name="InfoUploader" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="InfoDuration" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="InfoQualities" Style="{StaticResource MutedText}" />
          </StackPanel>
        </Grid>

        <StackPanel x:Name="PlaylistPanel" Margin="0,16,0,0" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Hiçbiri" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="SelectNone" />
            <Button DockPanel.Dock="Right" Content="Tümünü seç" Style="{StaticResource SubtleButton}" Click="SelectAll" />
            <TextBlock x:Name="PlaylistCount" VerticalAlignment="Center" FontWeight="SemiBold" />
          </DockPanel>
          <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="EntryList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3">
                      <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>

        <TextBlock Text="Biçim" Style="{StaticResource SmallLabel}" Margin="0,16,0,4" />
        <ComboBox x:Name="PresetBox" SelectionChanged="PresetChanged" />
        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <ComboBox x:Name="FormatList" SelectionChanged="FormatPicked" ToolTip="Mevcut biçimlerden birini seç veya aşağıya kendin yaz" />
          <TextBox x:Name="FormatBox" FontFamily="{StaticResource MonoFont}" core:ThemeAssist.Placeholder="Örn. 137+140" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource SmallLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="yt-dlp biçim seçicisi: ör. 137+140 (video+ses) ya da bv*[height&lt;=720]+ba/b." />
        </StackPanel>

        <TextBlock Text="Çıktı klasörü" Style="{StaticResource SmallLabel}" Margin="0,12,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="OutputBox" />
          <Button Grid.Column="1" Content="Seç…" core:ThemeAssist.Icon="&#xE8B7;" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="BrowseOutput" />
        </Grid>

        <TextBlock Text="Dosya adı şablonu" Style="{StaticResource SmallLabel}" Margin="0,12,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TemplateBox" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Dosya adı şablonu" />
          <Button Grid.Column="1" Content="Varsayılan" core:ThemeAssist.Icon="&#xE777;" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="ResetTemplate" />
        </Grid>
        <TextBlock Style="{StaticResource SmallLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Alanlar: %(title)s, %(id)s, %(uploader)s, %(upload_date)s, %(playlist_index)s; uzantı %(ext)s. Alt klasör için / kullanılabilir." />

        <WrapPanel Margin="0,16,0,0">
          <Button x:Name="DownloadButton" Content="İndir" core:ThemeAssist.Icon="&#xE896;" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="DownloadClicked" />
        </WrapPanel>
        <TextBlock x:Name="DownloadStatus" Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <!-- Queue -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Bitenleri temizle" core:ThemeAssist.Icon="&#xE74D;" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" VerticalAlignment="Top" Click="ClearFinished" />
          <ComboBox DockPanel.Dock="Right" x:Name="ParallelBox" Width="64" VerticalAlignment="Top" SelectionChanged="ParallelChanged" />
          <TextBlock DockPanel.Dock="Right" Text="Aynı anda" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="0,0,8,6" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="İndirmeler" Style="{StaticResource SectionHeading}" Margin="0" /><Border Style="{StaticResource Chip}" Margin="10,0,0,0"><TextBlock x:Name="QueueCount" Text="0" /></Border></StackPanel>
        </DockPanel>
                <StackPanel x:Name="QueueEmpty" Style="{StaticResource EmptyStatePanel}" Margin="0,24,0,32">
          <Border Style="{StaticResource EmptyStateIcon}"><TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="{StaticResource IconSizeLarge}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="İlk indirmene hazır" Style="{StaticResource EmptyStateTitle}" />
          <TextBlock Text="Yukarıya bir bağlantı ekle. İndirmelerin ve ilerlemeleri burada görünecek." Style="{StaticResource EmptyStateText}" />
        </StackPanel>
        <ItemsControl x:Name="QueueList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource InsetPanel}" Padding="16,14" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding PresetText}" Style="{StaticResource SmallLabel}" />
                  <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,4" />
                  <TextBlock Text="{Binding DetailText}" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="İptal" core:ThemeAssist.Icon="&#xE711;" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Click="CancelItem"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Tekrar dene" core:ThemeAssist.Icon="&#xE72C;" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Click="RetryItem"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Dosyayı aç" core:ThemeAssist.Icon="&#xE8E5;" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Click="OpenItemFile"
                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Klasörde göster" core:ThemeAssist.Icon="&#xE8B7;" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Click="RevealItemFile"
                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Listeden kaldır" Style="{StaticResource SubtleButton}" Click="RemoveItem"
                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="HistoryPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
    <StackPanel>
    <!-- History -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Geçmişi temizle" core:ThemeAssist.Icon="&#xE74D;" Style="{StaticResource SubtleButton}" VerticalAlignment="Top" Click="ClearHistory" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="İndirme geçmişi" Style="{StaticResource SectionHeading}" Margin="0" /><Border Style="{StaticResource Chip}" Margin="10,0,0,0"><TextBlock x:Name="HistoryCount" Text="0" /></Border></StackPanel>
        </DockPanel>
                <StackPanel x:Name="HistoryEmpty" Style="{StaticResource EmptyStatePanel}" Margin="0,40">
          <Border Style="{StaticResource EmptyStateIcon}"><TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="{StaticResource IconSizeLarge}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Henüz tamamlanan indirme yok" Style="{StaticResource EmptyStateTitle}" />
          <TextBlock Text="Kaydettiğin video ve ses dosyalarına buradan ulaşabilirsin." Style="{StaticResource EmptyStateText}" />
        </StackPanel>
        <ItemsControl x:Name="HistoryList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <DockPanel>
                  <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Aç" core:ThemeAssist.Icon="&#xE8E5;" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OpenHistoryFile" />
                    <Button Content="Klasör" core:ThemeAssist.Icon="&#xE8B7;" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="RevealHistoryFile" />
                  </WrapPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SmallLabel}">
                      <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding FileName, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
    <StackPanel>
    <Border Style="{StaticResource SettingsCard}" Padding="{StaticResource CardPadding}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Bağlantılar ve oturum" Style="{StaticResource SectionHeading}" Margin="0,0,0,16" />
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="Kopyalanan video bağlantılarını algıla" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
            <TextBlock Text="Desteklenen bağlantılarda indirme kısayolu gösterilir. İndirmeyi sen başlatırsın." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <CheckBox x:Name="ClipboardToastsBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" AutomationProperties.Name="Kopyalanan video bağlantıları için bildirim göster" Checked="ClipboardToastsChanged" Unchecked="ClipboardToastsChanged" />
        </Grid>
        <Border Style="{StaticResource SettingRow}" Padding="0,18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="Tarayıcı oturumunu kullan" Style="{StaticResource BodyStrongText}" />
              <TextBlock Text="Giriş gerektiren içerikler için tarayıcı çerezlerini yt-dlp ile oku. Çerezler BroidShot'ta saklanmaz." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <CheckBox x:Name="CookiesBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" AutomationProperties.Name="Tarayıcı çerezlerini kullan" Checked="CookiesChanged" Unchecked="CookiesChanged" />
          </Grid>
        </Border>
        <TextBlock Text="Tarayıcı" Style="{StaticResource SmallLabel}" Margin="0,12,0,6" />
        <ComboBox x:Name="BrowserBox" Width="220" HorizontalAlignment="Left" SelectionChanged="BrowserChanged" AutomationProperties.Name="Çerezlerin okunacağı tarayıcı" />
        <TextBlock Text="Çerezler okunamıyorsa tarayıcıyı kapatıp tekrar dene. Bu seçeneği yalnız gerektiğinde aç." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0"><TextBlock Text="&#xE90F;" Style="{StaticResource IconText}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="İndirme araçları" Style="{StaticResource BodyStrongText}" /><TextBlock Text="yt-dlp ve ffmpeg" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel>
        </DockPanel>
        <TextBlock x:Name="ToolStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <Button x:Name="UpdateButton" Content="Güncellemeyi denetle" Style="{StaticResource SecondaryButton}" core:ThemeAssist.Icon="&#xE72C;" HorizontalAlignment="Left" Click="CheckUpdate" />
      </StackPanel>
    </Border>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
