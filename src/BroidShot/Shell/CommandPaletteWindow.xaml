<Window x:Class="BroidShot.Shell.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core"
        Title="BroidShot komut paleti" Width="660" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="KindChip" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsModule}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}" />
          <Setter Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" Margin="18" Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.6" Color="Black" />
    </Border.Effect>
    <StackPanel>
      <Grid Margin="18,10,14,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}" Padding="0,8" FontSize="16"
                 core:ThemeAssist.Placeholder="Araç veya komut ara…" AutomationProperties.Name="Araç veya komut ara" TextChanged="SearchChanged" />
        <Border Grid.Column="2" Style="{StaticResource Keycap}" Margin="12,0,0,0">
          <TextBlock Text="Esc" />
        </Border>
      </Grid>
      <Border Height="1" Background="{StaticResource StrokeSubtleBrush}" />
      <ListBox x:Name="ResultList" MaxHeight="420" Margin="6,6,6,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="None"
               PreviewMouseLeftButtonUp="ResultClicked" AutomationProperties.Name="Sonuçlar">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconTile}" Width="32" Height="32" Margin="0,0,12,0">
                <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,2,0">
                <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           MaxWidth="150" TextTrimming="CharacterEllipsis" />
                <Border Style="{StaticResource KindChip}">
                  <TextBlock Text="{Binding KindText}" />
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyText" Orientation="Horizontal" Margin="20,16,20,18" Visibility="Collapsed">
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,10,0" />
        <TextBlock Text="Eşleşen araç veya komut yok." Foreground="{StaticResource TextSecondaryBrush}" />
      </StackPanel>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,9">
        <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.Foreground="{StaticResource TextTertiaryBrush}">
          <Border Style="{StaticResource Keycap}"><TextBlock Text="↑" /></Border>
          <Border Style="{StaticResource Keycap}" Margin="3,0,0,0"><TextBlock Text="↓" /></Border>
          <TextBlock Text="seç" Margin="7,0,18,0" VerticalAlignment="Center" />
          <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" /></Border>
          <TextBlock Text="çalıştır" Margin="7,0,18,0" VerticalAlignment="Center" />
          <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" /></Border>
          <TextBlock Text="kapat" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
