<Window x:Class="BroidShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BroidShot"
        xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core"
        Title="BroidShot" Icon="/BroidShot;component/Branding/BroidShot.ico" Width="1240" Height="820" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource RailBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <local:HistoryThumbnailConverter x:Key="Thumbnail" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="SettingIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="OcrBadge" TargetType="Border" BasedOn="{StaticResource AccentChip}">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding OcrText}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding OcrText}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="ShellRoot" Background="{StaticResource RailBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="56" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============ Icon rail: brand, tools grouped by category, background jobs, settings ============ -->
    <Image Source="{StaticResource BroidShotLogo}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
           RenderOptions.BitmapScalingMode="HighQuality" ToolTip="BroidShot" AutomationProperties.Name="BroidShot" />
    <Grid x:Name="Rail" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="ModuleNav" HorizontalAlignment="Center" Margin="0,2,0,8" AutomationProperties.Name="Araçlar"
                    KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once" />
      </ScrollViewer>

      <Grid Grid.Row="1" HorizontalAlignment="Center">
        <Button x:Name="JobsPanel" Style="{StaticResource RailButton}" Visibility="Collapsed" Click="ToggleJobs" AutomationProperties.Name="Arka plan işleri">
          <Button.ToolTip>
            <TextBlock x:Name="JobsTooltip" Text="Arka plan işleri" />
          </Button.ToolTip>
          <Grid Width="40" Height="40">
            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Background="{StaticResource AccentBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,5,4,0">
              <TextBlock x:Name="JobsCount" Text="1" FontFamily="{StaticResource UiFont}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
        <Popup x:Name="JobsPopup" PlacementTarget="{Binding ElementName=JobsPanel}" Placement="Right" HorizontalOffset="12" VerticalOffset="-12"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <Border Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Width="340"
                  Padding="16,14,12,6" Margin="0,0,14,14" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14"
                  TextElement.Foreground="{StaticResource TextBrush}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="Arka plan işleri" Style="{StaticResource SectionHeading}" />
              <ItemsControl x:Name="JobList" AutomationProperties.Name="Arka plan işleri">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Margin="0,7,0,6" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource IconButton}" FontSize="11" VerticalAlignment="Top" Margin="8,-4,0,0"
                              ToolTip="İptal et" Click="CancelJob" AutomationProperties.Name="İşi iptal et"
                              Visibility="{Binding CanCancelNow, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <Button x:Name="SettingsNavButton" Grid.Row="2" Style="{StaticResource RailButton}" Content="&#xE713;" Click="ShowSettings" Margin="0,4,0,12"
              HorizontalAlignment="Center" AutomationProperties.Name="Ayarlar" />
    </Grid>

    <!-- ============ Top bar: current page, search (command palette), main action ============ -->
    <Grid x:Name="TopBar" Grid.Column="1" Margin="16,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="PageIconTile" Style="{StaticResource AccentIconTile}" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="PageGlyph" Style="{StaticResource IconText}" FontSize="16" HorizontalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
        <TextBlock x:Name="PageTitle" Text="Ekran alıntısı" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PageSubtitle" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
      </StackPanel>
      <Button x:Name="PaletteButton" Grid.Column="2" Style="{StaticResource SearchFieldButton}" Width="340" Click="OpenPalette"
              PreviewTextInput="PaletteButtonTextInput" AutomationProperties.Name="Komut paletini aç" ToolTip="Araçları ve komutları ara">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
          <Border DockPanel.Dock="Right" Style="{StaticResource Keycap}">
            <TextBlock x:Name="PaletteHintLabel" Text="Ctrl + K" />
          </Border>
          <TextBlock Text="Araç veya komut ara…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Button>
      <Button x:Name="NewCaptureButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE710;" Content="Yeni alıntı"
              Click="CaptureRegion" Margin="12,0,0,0" Height="36" Padding="14,0,16,0" AutomationProperties.Name="Yeni alıntı" ToolTip="Alan seç" />
    </Grid>

    <!-- ============ Content panel ============ -->
    <Border x:Name="ContentPanel" Grid.Row="1" Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}"
            BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Every page is a child of PageHost; only the selected one is visible. Module views are added at first navigation. -->
        <Grid x:Name="PageHost" ClipToBounds="True">

          <!-- ===== Ekran alıntısı ===== -->
          <Grid x:Name="ScreenshotPage" Margin="32,24,32,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="HeroTitle" Text="Alıntıların, elinin altında." Style="{StaticResource SubtitleText}" />
                <TextBlock Text="Ekranını yakala, düşünceni üzerine ekle." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
              </StackPanel>
              <Border x:Name="HotkeyCard" Grid.Column="1" VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="10,6,12,6" Margin="16,0,0,0" MaxWidth="420">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE765;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,10,0" />
                  <Border Style="{StaticResource Keycap}">
                    <TextBlock x:Name="HotkeyLabel" Text="F12" />
                  </Border>
                  <TextBlock x:Name="HotkeyStatus" Text="Alan seçimini başlatır" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>
              </Border>
            </Grid>

            <UniformGrid x:Name="CaptureModesPanel" Grid.Row="1" Columns="4" Margin="0,0,-12,12">
              <Button Click="CaptureRegion" Style="{StaticResource CaptureTile}" AutomationProperties.Name="Alan seç">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource AccentIconTile}" Width="40" Height="40" HorizontalAlignment="Left">
                    <Path Style="{StaticResource TileIcon}" Stroke="{StaticResource AccentTextBrush}"
                          Data="M 1,7 V 1 H 7 M 17,1 H 23 V 7 M 23,17 V 23 H 17 M 7,23 H 1 V 17 M 9,12 H 15 M 12,9 V 15" />
                  </Border>
                  <Border Style="{StaticResource Keycap}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock x:Name="RegionShortcutLabel" Text="F12" />
                  </Border>
                  <TextBlock Grid.Row="1" Text="Alan seç" Style="{StaticResource TileTitle}" />
                  <TextBlock Grid.Row="2" Text="İstediğin bölgeyi seç ve düzenle" Style="{StaticResource TileText}" />
                </Grid>
              </Button>
              <Button Click="CaptureWindow" Style="{StaticResource CaptureTile}" AutomationProperties.Name="Pencere yakala">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource IconTile}" Width="40" Height="40" HorizontalAlignment="Left">
                    <Path Style="{StaticResource TileIcon}" Data="M 2,3 H 22 V 21 H 2 Z M 2,8 H 22 M 5.5,5.5 H 6.5 M 8.5,5.5 H 9.5" />
                  </Border>
                  <TextBlock Grid.Row="1" Text="Pencere" Style="{StaticResource TileTitle}" />
                  <TextBlock Grid.Row="2" Text="Tek bir uygulama penceresi" Style="{StaticResource TileText}" />
                </Grid>
              </Button>
              <Button Click="CaptureMonitor" Style="{StaticResource CaptureTile}" AutomationProperties.Name="Monitörü yakala">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource IconTile}" Width="40" Height="40" HorizontalAlignment="Left">
                    <Path Style="{StaticResource TileIcon}" Data="M 2,3 H 22 V 17 H 2 Z M 12,17 V 21 M 7,21 H 17" />
                  </Border>
                  <TextBlock Grid.Row="1" Text="Monitör" Style="{StaticResource TileTitle}" />
                  <TextBlock Grid.Row="2" Text="İmlecin olduğu ekran" Style="{StaticResource TileText}" />
                </Grid>
              </Button>
              <Button Click="CaptureAll" Style="{StaticResource CaptureTile}" AutomationProperties.Name="Tüm ekranları yakala">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource IconTile}" Width="40" Height="40" HorizontalAlignment="Left">
                    <Path Style="{StaticResource TileIcon}" Data="M 1,6 H 13 V 15 H 1 Z M 15,9 H 23 V 18 H 15 Z M 5,19 H 9 M 7,15 V 19" />
                  </Border>
                  <TextBlock Grid.Row="1" Text="Tüm ekranlar" Style="{StaticResource TileTitle}" />
                  <TextBlock Grid.Row="2" Text="Masaüstünün tamamı" Style="{StaticResource TileText}" />
                </Grid>
              </Button>
            </UniformGrid>

            <!-- Keys available on the selection screen (capture overlay). -->
            <WrapPanel x:Name="OverlayKeysHint" Grid.Row="2" Margin="0,0,0,28" TextElement.FontSize="12" TextElement.Foreground="{StaticResource TextTertiaryBrush}"
                       AutomationProperties.Name="Seçim ekranı kısayolları: I renk seçici, M cetvel, Q QR, O metin tanıma">
              <TextBlock Text="Seçim ekranında:" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Border Style="{StaticResource Keycap}"><TextBlock Text="I" /></Border>
              <TextBlock Text="renk seçici" VerticalAlignment="Center" Margin="6,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />
              <Border Style="{StaticResource Keycap}"><TextBlock Text="M" /></Border>
              <TextBlock Text="cetvel" VerticalAlignment="Center" Margin="6,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />
              <Border Style="{StaticResource Keycap}"><TextBlock Text="Q" /></Border>
              <TextBlock Text="QR" VerticalAlignment="Center" Margin="6,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />
              <Border Style="{StaticResource Keycap}"><TextBlock Text="O" /></Border>
              <TextBlock Text="metin tanıma" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            </WrapPanel>

            <Grid x:Name="HistoryHeader" Grid.Row="3" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Son alıntılar" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Chip}" Margin="10,1,0,0">
                  <TextBlock x:Name="CountLabel" Text="0 alıntı" />
                </Border>
              </StackPanel>
              <TextBox x:Name="SearchBox" Grid.Column="1" Width="280" Style="{StaticResource SearchBox}" core:ThemeAssist.Placeholder="Geçmişte ara…"
                       ToolTip="Tarih veya OCR metninde ara" TextChanged="SearchChanged" AutomationProperties.Name="Geçmişte ara" />
            </Grid>

            <Grid x:Name="HistoryPanel" Grid.Row="4">
              <ListBox x:Name="HistoryList" ItemContainerStyle="{StaticResource HistoryCardItem}" SelectionChanged="HistorySelectionChanged"
                       MouseDoubleClick="HistoryDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                       AutomationProperties.Name="Son alıntılar">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="214">
                      <Border Height="128" CornerRadius="6" Background="{StaticResource ControlBrush}">
                        <Border CornerRadius="6">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                          </Border.Background>
                        </Border>
                      </Border>
                      <Grid Margin="4,10,2,3">
                        <StackPanel Margin="0,0,44,0">
                          <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Dimensions}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource OcrBadge}" ToolTip="Metni tanındı">
                          <TextBlock Text="OCR" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="EmptyState" Style="{StaticResource EmptyStatePanel}" Margin="0,0,0,40">
                <Border Style="{StaticResource EmptyStateIcon}" Width="72" Height="72" CornerRadius="18">
                  <Image Source="{StaticResource BroidShotLogo}" Width="40" Height="40" Opacity="0.8" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="İlk alıntın burada yerini bekliyor." Style="{StaticResource EmptyStateTitle}" />
                <TextBlock x:Name="EmptyText" Text="Alanını seç, düzenle ve kopyala. Geçmişin burada kalsın." Style="{StaticResource EmptyStateText}" />
                <Button x:Name="EmptyCaptureButton" Content="Alan seç" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE710;"
                        HorizontalAlignment="Center" Margin="0,20,0,0" Click="CaptureRegion" />
              </StackPanel>
            </Grid>

            <Border x:Name="HistoryActions" Grid.Row="5" Style="{StaticResource Toolbar}" Margin="0,6,0,20">
              <DockPanel>
                <TextBlock x:Name="SelectionLabel" DockPanel.Dock="Right" Text="Bir alıntı seç" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" />
                <WrapPanel VerticalAlignment="Center">
                  <Button Content="Kopyala" core:ThemeAssist.Icon="&#xE8C8;" Style="{StaticResource ToolbarButton}" Click="CopySelected" ToolTip="Panoya kopyala" />
                  <Button Content="Düzenle" core:ThemeAssist.Icon="&#xE70F;" Style="{StaticResource ToolbarButton}" Click="EditSelected" ToolTip="Düzenleyicide aç" />
                  <Button Content="Farklı kaydet" core:ThemeAssist.Icon="&#xE74E;" Style="{StaticResource ToolbarButton}" Click="SaveSelected" />
                  <Button Content="Metni çıkar (OCR)" core:ThemeAssist.Icon="&#xE8E4;" Style="{StaticResource ToolbarButton}" Click="OcrSelected" />
                  <Border Style="{StaticResource VerticalDivider}" Height="20" />
                  <Button Content="Sil" core:ThemeAssist.Icon="&#xE74D;" Style="{StaticResource DangerButton}" Click="DeleteSelected" ToolTip="Yerel geçmişten sil" />
                </WrapPanel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- ===== Ayarlar ===== -->
          <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="860" Margin="32,24,32,8" HorizontalAlignment="Stretch">

              <TextBlock Text="Başlangıç ve arka plan" Style="{StaticResource SectionHeading}" />
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Pencereyi kapatınca arka planda çalışmaya devam et" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="BackgroundStatusLabel" Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <CheckBox x:Name="RunInBackgroundCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                                Checked="RunInBackgroundChanged" Unchecked="RunInBackgroundChanged" AutomationProperties.Name="Pencereyi kapatınca arka planda çalışmaya devam et" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7B5;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Windows'ta oturum açınca BroidShot'u başlat" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="StartupStatusLabel" Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged" AutomationProperties.Name="Windows'ta oturum açınca BroidShot'u başlat" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingRow}" Background="{StaticResource ControlBrush}" CornerRadius="0,0,9,9">
                    <Grid Margin="36,0,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Windows başlangıcında pencereyi açmadan tepside başlat" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Tepside başlatma, arka planda çalışma ve Windows ile başlatma açıkken kullanılabilir." Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <CheckBox x:Name="StartInTrayCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                                Checked="StartInTrayChanged" Unchecked="StartInTrayChanged" AutomationProperties.Name="Windows başlangıcında pencereyi açmadan tepside başlat" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <TextBlock Text="Yakalama ve kayıt" Style="{StaticResource SectionHeading}" />
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE81C;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Bitirilen alıntıları yerel geçmişte tut" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Geçmiş de diske kayıt yapar. Yalnız son görüntü saklanır; ham ekran saklanmaz. Varsayılan sınır: 30 gün veya 1 GB."
                                   Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <CheckBox x:Name="KeepHistoryCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                                Checked="SettingChanged" Unchecked="SettingChanged" AutomationProperties.Name="Bitirilen alıntıları yerel geçmişte tut" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE8B7;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Kayıt klasörü" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Farklı kaydet penceresi bu klasörden açılır." Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <DockPanel Grid.Column="2" Width="380" VerticalAlignment="Center">
                        <Button Content="Seç…" DockPanel.Dock="Right" Click="ChooseFolder" Margin="8,0,0,0" AutomationProperties.Name="Kayıt klasörü seç" />
                        <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="Kayıt klasörü" />
                      </DockPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE8E4;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Yerel OCR" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="OcrStatus" Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <TextBlock Text="Kısayollar" Style="{StaticResource SectionHeading}" />
              <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                <StackPanel>
                  <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE765;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="F12 ile alan seçimini aç" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Uygulama çalışırken F12 her yerden alan seçimini başlatır." Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <CheckBox x:Name="F12EnabledCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                                Checked="F12SettingChanged" Unchecked="F12SettingChanged" AutomationProperties.Name="F12 ile alan seçimini aç" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="İkincil kısayol" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="F12 ve ikincil kısayol, uygulama çalışırken alan seçimini başlatır. Sistem tepsisi menüsündeki Çıkış seçeneği uygulamayı tamamen kapatır."
                                   Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <ComboBox x:Name="HotkeyPresetBox" Grid.Column="2" Width="220" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="HotkeyChanged"
                                AutomationProperties.Name="Yakalama kısayolu">
                        <ComboBoxItem Content="Ctrl + Shift + S" />
                        <ComboBoxItem Content="Ctrl + Alt + S" />
                        <ComboBoxItem Content="Ctrl + Shift + F9" />
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE721;" Style="{StaticResource SettingIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Komut paleti kısayolu" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="PaletteHotkeyStatus" Style="{StaticResource SettingDescription}" />
                      </StackPanel>
                      <ComboBox x:Name="PaletteHotkeyBox" Grid.Column="2" Width="220" VerticalAlignment="Center" SelectionChanged="PaletteHotkeyChanged"
                                AutomationProperties.Name="Komut paleti kısayolu" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource InfoBar}" Margin="0,0,0,28">
                <DockPanel>
                  <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                  <TextBlock Text="HDR ekranlarda renkler farklı görünebilir. Bazı uygulamalar pencere yakalamayı desteklemez; bu durumda alan seçimini kullanabilirsin."
                             TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                </DockPanel>
              </Border>

              <TextBlock Text="Araçlar" Style="{StaticResource SectionHeading}" />
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <StackPanel x:Name="ModuleStatusList" />
                  <Border BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Background="{StaticResource ControlBrush}" CornerRadius="0,0,9,9" Padding="20,12">
                    <TextBlock x:Name="DataFolderLabel" Style="{StaticResource CaptionText}" LineHeight="18" />
                  </Border>
                </StackPanel>
              </Border>

              <TextBlock Text="Hakkında" Style="{StaticResource SectionHeading}" />
              <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <DockPanel>
                  <Image Source="{StaticResource BroidShotLogo}" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BroidShot" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionLabel" Text="Sürüm 0.3 alfa" Style="{StaticResource SettingDescription}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Status line -->
        <Border x:Name="StatusBar" Grid.Row="1" Height="30" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,0,20,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Ellipse Fill="{StaticResource SuccessBrush}" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Yerel çalışır" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusLabel" Text="Hazır · Alan seçmek için F12" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
