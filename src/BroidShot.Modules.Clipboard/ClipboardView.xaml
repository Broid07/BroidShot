<UserControl x:Class="BroidShot.Modules.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core">
  <!-- Theme keys come from BroidShot.Core/Themes/Theme.xaml (merged by the shell, or by the code-behind when hosted elsewhere). -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Small glyph-only action inside a card (copy, pin, tag…). -->
    <Style x:Key="ItemIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource ItemIconButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
          <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Row of the tag column (NavButton: Tag="selected" marks the active one). -->
    <Style x:Key="TagRowButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="TagRowIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="PlainListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Settings rows (same look as the shell's settings page). -->
    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="SettingIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="MetaSeparator" TargetType="TextBlock">
      <Setter Property="Text" Value="·" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="ClipItemTemplate">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource SectionLabel}" Margin="2,6,0,10"
                   Visibility="{Binding HasSectionTitle, Converter={StaticResource BoolToVisibility}}" />
        <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}" Padding="14,12,10,12" Margin="0,0,0,8" SnapsToDevicePixels="True">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Leading tile: type glyph, colour swatch or lock -->
            <Grid VerticalAlignment="Top" Margin="0,0,14,0">
              <Border x:Name="KindTile" Style="{StaticResource IconTile}">
                <TextBlock x:Name="KindIcon" Text="{Binding KindGlyph}" Style="{StaticResource IconText}" Foreground="{StaticResource TextSecondaryBrush}" />
              </Border>
              <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Swatch}" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1"
                      Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock x:Name="Preview" Text="{Binding PreviewText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" LineHeight="20"
                         Foreground="{StaticResource TextBrush}" Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
              <Border HorizontalAlignment="Left" CornerRadius="6" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1" Background="{StaticResource ControlBrush}"
                      Visibility="{Binding ShowImage, Converter={StaticResource BoolToVisibility}}">
                <Image Source="{Binding Thumbnail}" MaxHeight="112" MaxWidth="300" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
              <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding KindText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource MetaSeparator}" />
                <TextBlock Text="{Binding DetailText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Chip}" Margin="0,0,4,0">
                        <TextBlock Text="{Binding StringFormat='#{0}'}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
              <!-- Sensitive: reason + countdown until the item is wiped -->
              <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource AccentChip}" Margin="0,0,6,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="10" Margin="0,1,5,0" />
                    <TextBlock Text="{Binding SensitiveReasonText, StringFormat='Hassas · {0}'}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{Binding HasExpiry, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" Style="{StaticResource IconText}" FontSize="10" Margin="0,1,5,0" />
                    <TextBlock Text="{Binding ExpiryText}" />
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>

            <!-- Actions: reveal is always there for sensitive items; the rest appears on hover / keyboard focus -->
            <Grid Grid.Column="2" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel x:Name="HoverActions" Orientation="Horizontal" Opacity="0">
                  <Button Style="{StaticResource ItemIconButton}" Content="&#xE8C8;" ToolTip="Kopyala" AutomationProperties.Name="Kopyala" Click="CopyItem" />
                  <Button Style="{StaticResource ItemIconButton}" Content="&#xE77F;" ToolTip="Önceki pencereye yapıştır" AutomationProperties.Name="Yapıştır" Click="PasteItem" />
                  <Button Style="{StaticResource ItemIconButton}" Content="{Binding PinGlyph}" ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinToolTip}" Click="TogglePin" />
                  <Button Style="{StaticResource ItemIconButton}" Content="&#xE8EC;" ToolTip="Etiketler" AutomationProperties.Name="Etiketler" Click="EditTags" />
                  <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="Sil" AutomationProperties.Name="Sil" Click="DeleteItem" />
                </StackPanel>
                <Button Style="{StaticResource ItemIconButton}" Content="{Binding RevealGlyph}" ToolTip="{Binding RevealToolTip}" AutomationProperties.Name="{Binding RevealToolTip}"
                        Click="RevealItem" Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <TextBlock x:Name="PinMark" Text="&#xE718;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource AccentTextBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" ToolTip="Sabitlendi" Visibility="Collapsed" />
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True">
          <Setter TargetName="PinMark" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSensitive}" Value="True">
          <Setter TargetName="KindTile" Property="Style" Value="{StaticResource AccentIconTile}" />
          <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMasked}" Value="True">
          <Setter TargetName="Preview" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
          <Setter TargetName="Preview" Property="FontFamily" Value="{StaticResource MonoFont}" />
        </DataTrigger>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
          <Setter TargetName="HoverActions" Property="Opacity" Value="1" />
          <Setter TargetName="PinMark" Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="HoverActions" Property="Opacity" Value="1" />
          <Setter TargetName="PinMark" Property="Visibility" Value="Collapsed" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar: search, settings, clear -->
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchChanged"
               core:ThemeAssist.Placeholder="Geçmişte ara: metin, etiket, uygulama" AutomationProperties.Name="Pano geçmişinde ara" />
      <TextBlock x:Name="SettingsHeading" Text="Değişiklikler «Ayarları kaydet» ile uygulanır." Style="{StaticResource MutedText}" VerticalAlignment="Center" Visibility="Collapsed" />
      <ToggleButton x:Name="SettingsToggle" Grid.Column="1" Content="Ayarlar" core:ThemeAssist.Icon="&#xE713;" Margin="12,0,0,0"
                    Checked="SettingsToggled" Unchecked="SettingsToggled" ToolTip="İzleme, Win+V, saklama ve gizlilik ayarları" />
      <Button x:Name="ClearButton" Grid.Column="2" Content="Geçmişi temizle" core:ThemeAssist.Icon="&#xE74D;" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
              Click="AskClear" ToolTip="Sabitlenmemiş bütün öğeleri sil" />
    </Grid>

    <!-- Confirmation bar -->
    <Border x:Name="ConfirmBar" Grid.Row="1" Style="{StaticResource WarningBar}" Margin="0,0,0,16" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" />
        <TextBlock x:Name="ConfirmText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
          <Button x:Name="ConfirmButton" Content="Sil" Style="{StaticResource PrimaryButton}" Click="ConfirmYes" />
          <Button Content="Vazgeç" Style="{StaticResource SubtleButton}" Margin="0" Click="ConfirmNo" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== History: tags column + filters + list ===== -->
    <Grid x:Name="HistoryPanel" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <!-- Tags ("folders") -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TagNameBox" FontSize="{StaticResource FontSizeSmall}" KeyDown="TagNameKeyDown" core:ThemeAssist.Placeholder="Yeni etiket"
                     AutomationProperties.Name="Etiket adı" />
            <Button x:Name="TagSaveButton" Grid.Column="1" Content="Ekle" Margin="6,0,0,0" Padding="12,6" FontSize="{StaticResource FontSizeSmall}" Click="SaveTag" />
          </Grid>
          <TextBlock x:Name="TagEditHint" Style="{StaticResource CaptionText}" Margin="2,8,0,0" LineHeight="16"
                     Text="Bir öğeye etiket vermek için öğedeki etiket düğmesini kullan." />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <TextBlock Text="Etiketler" Style="{StaticResource SectionLabel}" Margin="12,4,0,8" />
            <Button x:Name="AllTagsButton" Style="{StaticResource TagRowButton}" Click="SelectAllTags" Tag="selected">
              <DockPanel>
                <TextBlock x:Name="AllCount" DockPanel.Dock="Right" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="&#xE8FD;" Style="{StaticResource TagRowIcon}" />
                <TextBlock Text="Bütün öğeler" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </Button>
            <ItemsControl x:Name="TagList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid x:Name="Row">
                    <Button Style="{StaticResource TagRowButton}" Tag="{Binding SelectedTag}" Click="SelectTag">
                      <DockPanel>
                        <TextBlock x:Name="Count" DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="&#xE8EC;" Style="{StaticResource TagRowIcon}" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                    <StackPanel x:Name="RowActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,2" Visibility="Hidden">
                      <Button Style="{StaticResource ItemIconButton}" MinWidth="26" MinHeight="26" FontSize="12" Content="&#xE70F;" ToolTip="Yeniden adlandır"
                              AutomationProperties.Name="Yeniden adlandır" Click="RenameTag" />
                      <Button Style="{StaticResource DangerIconButton}" MinWidth="26" MinHeight="26" FontSize="12" Content="&#xE74D;" ToolTip="Etiketi sil"
                              AutomationProperties.Name="Etiketi sil" Click="DeleteTag" />
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Count" Property="Visibility" Value="Hidden" />
                    </Trigger>
                    <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                      <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Count" Property="Visibility" Value="Hidden" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="1" Style="{StaticResource VerticalDivider}" HorizontalAlignment="Center" Margin="0" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Type filter chips (built in code from ClipFilter.Chips) -->
        <WrapPanel x:Name="ChipPanel" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
          <ListBox x:Name="ItemList" ItemTemplate="{StaticResource ClipItemTemplate}" ItemContainerStyle="{StaticResource PlainListItem}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                   AutomationProperties.Name="Pano geçmişi" />
          <StackPanel x:Name="EmptyState" Style="{StaticResource EmptyStatePanel}" Margin="0,0,0,60" Visibility="Collapsed">
            <Border Style="{StaticResource EmptyStateIcon}">
              <TextBlock x:Name="EmptyIcon" Text="&#xE77F;" Style="{StaticResource IconText}" FontSize="26" />
            </Border>
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource EmptyStateTitle}" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyStateText}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== Settings (secondary area, opened with the Ayarlar toggle) ===== -->
    <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,12,0">

        <TextBlock Text="Pano geçmişi" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE890;" Style="{StaticResource SettingIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="Panoyu izle" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Kopyaladığın metin, görsel ve dosyalar geçmişe eklenir." Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <CheckBox x:Name="MonitoringBox" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" AutomationProperties.Name="Panoyu izle" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE765;" Style="{StaticResource SettingIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock x:Name="QuickPanelTitle" Text="Hızlı panel kısayolu" Style="{StaticResource SettingTitle}" />
                  <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <CheckBox x:Name="QuickPanelBox" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" AutomationProperties.Name="Hızlı panel kısayolu" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <TextBlock Text="Saklama" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8FD;" Style="{StaticResource SettingIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="En fazla öğe" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Sabitlenenler hariç; sınır aşılınca en eski öğeler silinir. En az 10." Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <TextBox x:Name="MaxItemsBox" Grid.Column="2" Width="110" VerticalAlignment="Center" AutomationProperties.Name="En fazla öğe" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE81C;" Style="{StaticResource SettingIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="En uzun saklama (gün)" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Bu süre boyunca kullanılmayan sabitlenmemiş öğeler silinir." Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <TextBox x:Name="MaxAgeBox" Grid.Column="2" Width="110" VerticalAlignment="Center" AutomationProperties.Name="En uzun saklama (gün)" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <TextBlock Text="Gizlilik" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;" Style="{StaticResource SettingIcon}" Foreground="{StaticResource AccentTextBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Hassas veriler" Style="{StaticResource SettingTitle}" />
                  <TextBlock Style="{StaticResource SettingDescription}"
                             Text="Parola, kart numarası, IBAN, API anahtarı, JWT ve özel anahtar gibi içerikler ile kaynak uygulamanın hassas işaretlediği kopyalar maskeli gösterilir ve kopyalandıktan 1 saat sonra bellekten ve diskten silinir. Bütün içerik Windows hesabına bağlı olarak şifrelenir (DPAPI)." />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="&#xE8F8;" Style="{StaticResource SettingIcon}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Kaydedilmeyecek uygulamalar" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Bu uygulamalardan yapılan kopyalar hiç kaydedilmez. Her satıra bir işlem adı yaz (ör. KeePass, 1Password)." Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <TextBox x:Name="BlocklistBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource CodeTextBox}" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                         MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Kaydedilmeyecek uygulamalar" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Ayarları kaydet" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE74E;" Click="SaveSettings" />
          <TextBlock x:Name="SettingsStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
