<UserControl x:Class="BroidShot.Modules.Convert.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core"
             xmlns:local="clr-namespace:BroidShot.Modules.Convert">
  <!-- Theme keys come from BroidShot.Core/Themes/Theme.xaml (Application.Resources). The shell adds the page padding;
       the root is a Grid, so the page fills the content area and scrolls its own lists. -->
  <UserControl.Resources>

    <!-- ===== Option rows ===== -->
    <Style x:Key="OptionRow" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="OptionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="OptionHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="LineHeight" Value="17" />
    </Style>

    <!-- ===== Segmented choice: a ListBox whose items sit side by side (selection = ListBoxItem.Tag) ===== -->
    <Style x:Key="SegmentItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualInset}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontWeight" Value="Medium" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Segmented" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ItemsPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Operation tiles (files added): one row of selectable cards ===== -->
    <DataTemplate x:Key="OperationTileTemplate" DataType="{x:Type local:OperationChoice}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="Icon" Style="{StaticResource IconTile}" Width="32" Height="32" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
        </Border>
        <Border x:Name="Check" Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed">
          <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" />
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,3" />
        <TextBlock Grid.Row="2" Text="{Binding Caption}" Style="{StaticResource CaptionText}" LineHeight="16" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Icon" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
          <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
          <Setter TargetName="Check" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="OperationTileItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Padding" Value="14,12,12,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="ToolTip" Value="{Binding FullTitle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Tag = column count (set by code: at least 4, so two tiles do not stretch across the page). -->
    <Style x:Key="TileStrip" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="ItemContainerStyle" Value="{StaticResource OperationTileItem}" />
      <Setter Property="ItemTemplate" Value="{StaticResource OperationTileTemplate}" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter Margin="0,0,-10,0" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Quick start tiles (empty page) ===== -->
    <DataTemplate x:Key="QuickOperationTemplate" DataType="{x:Type local:OperationChoice}">
      <Button Style="{StaticResource TileButton}" Tag="{Binding Operation}" Click="QuickOperation" Margin="0,0,10,10" Padding="14,12"
              ToolTip="{Binding Caption}" AutomationProperties.Name="{Binding FullTitle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}" Width="32" Height="32" VerticalAlignment="Center">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding FullTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- ===== Status chips of a file row (one visible per state) ===== -->
    <Style x:Key="StateGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,1,5,0" />
    </Style>
    <Style x:Key="QueuedChip" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Queued">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Cancelled">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WorkingChip" TargetType="Border" BasedOn="{StaticResource AccentChip}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DoneChip" TargetType="Border" BasedOn="{StaticResource SuccessChip}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WarnChip" TargetType="Border" BasedOn="{StaticResource WarningChip}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Warning">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FailedChip" TargetType="Border" BasedOn="{StaticResource DangerChip}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- ===== File row ===== -->
    <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type local:ConvertItem}">
      <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,11,10,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="KindTile" Style="{StaticResource IconTile}" Background="{StaticResource InfoSubtleBrush}" TextElement.Foreground="{StaticResource InfoBrush}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="18" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <DockPanel>
              <TextBlock x:Name="LockGlyph" DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                         Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Parola korumalı: dönüştürürken parola sorulur" />
              <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            </DockPanel>
            <TextBlock Text="{Binding Info}" Style="{StaticResource SmallLabel}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
            <ProgressBar x:Name="ItemBar" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,8,0,1" Visibility="Collapsed" />
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Border Style="{StaticResource QueuedChip}">
              <TextBlock Text="{Binding ChipText}" />
            </Border>
            <Border Style="{StaticResource WorkingChip}">
              <TextBlock Text="{Binding ChipText}" />
            </Border>
            <Border Style="{StaticResource DoneChip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource StateGlyph}" />
                <TextBlock Text="{Binding ChipText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource WarnChip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource StateGlyph}" />
                <TextBlock Text="{Binding ChipText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource FailedChip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE783;" Style="{StaticResource StateGlyph}" />
                <TextBlock Text="{Binding ChipText}" />
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Content="&#xE74A;" Style="{StaticResource IconButton}" Tag="{Binding}" Click="MoveUp" ToolTip="Yukarı taşı" AutomationProperties.Name="Yukarı taşı" />
            <Button Content="&#xE74B;" Style="{StaticResource IconButton}" Tag="{Binding}" Click="MoveDown" ToolTip="Aşağı taşı" AutomationProperties.Name="Aşağı taşı" />
            <Button Content="&#xE711;" Style="{StaticResource IconButton}" Tag="{Binding}" Click="RemoveItem" ToolTip="Listeden çıkar" AutomationProperties.Name="Listeden çıkar" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        </Trigger>
        <DataTrigger Binding="{Binding Kind}" Value="Pdf">
          <Setter TargetName="KindTile" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
          <Setter TargetName="KindTile" Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsProtected}" Value="True">
          <Setter TargetName="LockGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Working">
          <Setter TargetName="ItemBar" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter TargetName="StatusLine" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Warning">
          <Setter TargetName="StatusLine" Property="Visibility" Value="Visible" />
          <Setter TargetName="StatusLine" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter TargetName="StatusLine" Property="Visibility" Value="Visible" />
          <Setter TargetName="StatusLine" Property="Foreground" Value="{StaticResource DangerBrush}" />
          <Setter TargetName="Row" Property="Background" Value="{StaticResource DangerSubtleBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Cancelled">
          <Setter TargetName="StatusLine" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <!-- While a batch runs the list is locked (FileList.Tag = "running"). -->
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="running">
          <Setter TargetName="Actions" Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Combined result rows (merge, images → PDF) ===== -->
    <DataTemplate x:Key="ResultRowTemplate" DataType="{x:Type local:ResultRow}">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,3,8,0" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Visibility="{Binding DetailVisibility}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="PageRoot" AllowDrop="True" Drop="OnDrop" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave">

    <!-- Model of the selected operation (tests and code read it); the visible picker is OperationTiles. -->
    <ComboBox x:Name="OperationBox" SelectionChanged="OperationChanged" Visibility="Collapsed" />

    <!-- ===================== Empty page: drop zone + quick start ===================== -->
    <Grid x:Name="EmptyPanel">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="260" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="DropZone" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusCard}" SnapsToDevicePixels="True">
        <Grid>
          <Rectangle x:Name="DropDash" RadiusX="10" RadiusY="10" Stroke="{StaticResource StrokeStrongBrush}" StrokeThickness="1.5" StrokeDashArray="5 4"
                     SnapsToDevicePixels="True" IsHitTestVisible="False" />
          <StackPanel Style="{StaticResource EmptyStatePanel}" MaxWidth="520">
            <Border x:Name="DropIcon" Style="{StaticResource EmptyStateIcon}" Width="72" Height="72" CornerRadius="18" Background="{StaticResource AccentSubtleBrush}"
                    BorderBrush="{StaticResource AccentMutedBrush}" TextElement.Foreground="{StaticResource AccentTextBrush}">
              <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="28" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Dosyaları buraya bırak" Style="{StaticResource EmptyStateTitle}" FontSize="{StaticResource FontSizeSubtitle}"
                       TextOptions.TextFormattingMode="Ideal" Margin="0,20,0,8" />
            <TextBlock Text="PDF'leri ve görselleri ya da bir klasörü sürükle. Dosya türüne uyan işlemler ve ayarları hemen gösterilir."
                       Style="{StaticResource EmptyStateText}" />
            <Button Content="Dosya seç" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE8E5;" Click="BrowseFiles" HorizontalAlignment="Center"
                    Margin="0,22,0,0" Padding="18,7" />
            <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
              <WrapPanel.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                  <Setter Property="Margin" Value="3,0" />
                </Style>
              </WrapPanel.Resources>
              <Border><TextBlock Text="PDF" /></Border>
              <Border><TextBlock Text="PNG" /></Border>
              <Border><TextBlock Text="JPG" /></Border>
              <Border><TextBlock Text="WebP" /></Border>
              <Border><TextBlock Text="HEIC" /></Border>
              <Border><TextBlock Text="TIFF" /></Border>
              <Border><TextBlock Text="GIF" /></Border>
              <Border><TextBlock Text="BMP" /></Border>
              <Border><TextBlock Text="ICO" /></Border>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Grid.Row="1" Text="Ya da bir işlemle başla" Style="{StaticResource SectionLabel}" Margin="0,22,0,10" />
      <ItemsControl x:Name="QuickOperations" Grid.Row="2" ItemTemplate="{StaticResource QuickOperationTemplate}" Margin="0,0,-10,-10" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Grid>

    <!-- ===================== Files added: operation, list, options, run ===================== -->
    <Grid x:Name="FilesPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Operation picker -->
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="İşlem" Style="{StaticResource SectionLabel}" />
        <ListBox x:Name="OperationTiles" Style="{StaticResource TileStrip}" SelectionChanged="OperationTileChanged" AutomationProperties.Name="İşlem" />
        <Border x:Name="MixedBar" Style="{StaticResource WarningBar}" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top"
                       Margin="0,2,12,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Yalnız PDF'leri tut" Style="{StaticResource SubtleButton}" Click="KeepPdfs" />
              <Button Content="Yalnız görselleri tut" Style="{StaticResource SubtleButton}" Click="KeepImages" Margin="0" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Listede hem PDF hem görsel var" FontWeight="SemiBold" />
              <TextBlock Text="Her işlem tek tür dosyayla çalışır. Birini listeden çıkar ya da yalnız bir türü tut." Style="{StaticResource MutedText}"
                         FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="320" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- File list -->
        <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12,10,12">
              <DockPanel>
                <StackPanel x:Name="ListActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Ekle" Style="{StaticResource GhostButton}" core:ThemeAssist.Icon="&#xE710;" Click="BrowseFiles" Margin="0,0,2,0"
                          ToolTip="Listeye dosya ekle" />
                  <Button Content="Ada göre sırala" Style="{StaticResource GhostButton}" core:ThemeAssist.Icon="&#xE8CB;" Click="SortByName" Margin="0,0,2,0" />
                  <Button Content="Temizle" Style="{StaticResource GhostButton}" core:ThemeAssist.Icon="&#xE74D;" Click="ClearList" Margin="0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ListTitle" Text="Dosyalar" Style="{StaticResource SectionHeading}" Margin="0" />
                  <TextBlock x:Name="ListSummary" Style="{StaticResource SmallLabel}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl x:Name="FileList" ItemTemplate="{StaticResource FileRowTemplate}" Focusable="False" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="12">
              <TextBlock x:Name="ListNote" Style="{StaticResource CaptionText}" Margin="4,0,4,10" Visibility="Collapsed" />
              <Border x:Name="DropStrip" Height="52" CornerRadius="8" Background="Transparent">
                <Grid>
                  <Rectangle x:Name="DropStripDash" RadiusX="8" RadiusY="8" Stroke="{StaticResource StrokeStrongBrush}" StrokeThickness="1" StrokeDashArray="4 3"
                             SnapsToDevicePixels="True" IsHitTestVisible="False" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="DropTitle" Text="Daha fazla dosya bırak" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="ya da" Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" Margin="5,0,1,0" />
                    <Button Content="dosya seç" Style="{StaticResource LinkButton}" FontSize="{StaticResource FontSizeSmall}" Click="BrowseFiles" Margin="0" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Options, output and run -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="OptionsPanel">
              <Border x:Name="OptionsCard" Style="{StaticResource Card}" Padding="20,16,20,2" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE9E9;" Style="{StaticResource IconText}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="OptionsTitle" Text="Ayarlar" Style="{StaticResource SectionHeading}" Margin="0" />
                  </DockPanel>
                  <TextBlock x:Name="OperationHint" Style="{StaticResource CaptionText}" LineHeight="17" Margin="0,0,0,16" />

                  <StackPanel x:Name="RowPageRange" Style="{StaticResource OptionRow}">
                    <TextBlock x:Name="PageRangeLabel" Text="Sayfalar" Style="{StaticResource OptionLabel}" />
                    <TextBox x:Name="PageRangeBox" core:ThemeAssist.Placeholder="Örn. 1-3, 5, 8-" ToolTip="Örnek: 1-3,5 · 4- (4. sayfadan sona kadar)" />
                  </StackPanel>
                  <StackPanel x:Name="RowRasterFormat" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Biçim" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="RasterFormatBox" Style="{StaticResource Segmented}" SelectionChanged="OptionVisibilityChanged" AutomationProperties.Name="Biçim">
                      <ListBoxItem Content="PNG" Tag="Png" />
                      <ListBoxItem Content="JPG" Tag="Jpg" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowDpi" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Çözünürlük (DPI)" Style="{StaticResource OptionLabel}" />
                    <DockPanel>
                      <TextBox x:Name="CustomDpiBox" DockPanel.Dock="Right" Width="72" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="10 ile 1200 arası"
                               core:ThemeAssist.Placeholder="DPI" />
                      <ListBox x:Name="DpiBox" Style="{StaticResource Segmented}" SelectionChanged="DpiChanged" AutomationProperties.Name="Çözünürlük">
                        <ListBoxItem Content="72" Tag="72" ToolTip="Ekran" />
                        <ListBoxItem Content="150" Tag="150" ToolTip="Varsayılan" />
                        <ListBoxItem Content="300" Tag="300" ToolTip="Baskı" />
                        <ListBoxItem Content="Özel" Tag="0" />
                      </ListBox>
                    </DockPanel>
                    <TextBlock Text="72 ekran · 150 genel kullanım · 300 baskı kalitesi" Style="{StaticResource OptionHint}" />
                  </StackPanel>
                  <StackPanel x:Name="RowTarget" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Hedef biçim" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="TargetBox" Style="{StaticResource Segmented}" SelectionChanged="OptionVisibilityChanged" AutomationProperties.Name="Hedef biçim">
                      <ListBoxItem Content="PNG" Tag="Png" />
                      <ListBoxItem Content="JPG" Tag="Jpg" />
                      <ListBoxItem Content="BMP" Tag="Bmp" />
                      <ListBoxItem Content="TIFF" Tag="Tiff" />
                      <ListBoxItem Content="GIF" Tag="Gif" ToolTip="Tek kare" />
                      <ListBoxItem Content="ICO" Tag="Ico" ToolTip="Windows simgesi" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowJpgQuality" Style="{StaticResource OptionRow}">
                    <TextBlock Text="JPG kalitesi" Style="{StaticResource OptionLabel}" />
                    <DockPanel>
                      <TextBox x:Name="JpgQualityBox" Width="72" DockPanel.Dock="Left" />
                      <TextBlock Text="1–100 · yüksek değer daha net ama daha büyük dosya" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </DockPanel>
                  </StackPanel>
                  <StackPanel x:Name="RowPngCompression" Style="{StaticResource OptionRow}">
                    <TextBlock Text="PNG sıkıştırma" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="PngCompressionBox" Style="{StaticResource Segmented}" AutomationProperties.Name="PNG sıkıştırma">
                      <ListBoxItem Content="Hızlı" Tag="Fast" />
                      <ListBoxItem Content="Dengeli" Tag="Balanced" />
                      <ListBoxItem Content="En küçük" Tag="Smallest" ToolTip="En küçük dosya (yavaş)" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowResizeMode" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Boyut" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="ResizeModeBox" Style="{StaticResource Segmented}" SelectionChanged="OptionVisibilityChanged" AutomationProperties.Name="Yeniden boyutlandır">
                      <ListBoxItem Content="Aynı kalsın" Tag="None" />
                      <ListBoxItem Content="Yüzde" Tag="Percent" />
                      <ListBoxItem Content="Sınırla" Tag="MaxSize" ToolTip="En büyük genişlik / yükseklik" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowPercent" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Yüzde" Style="{StaticResource OptionLabel}" />
                    <StackPanel Orientation="Horizontal">
                      <TextBox x:Name="PercentBox" Width="72" />
                      <TextBlock Text="%" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="RowMaxSize" Style="{StaticResource OptionRow}">
                    <TextBlock Text="En büyük boyut (piksel)" Style="{StaticResource OptionLabel}" />
                    <StackPanel Orientation="Horizontal">
                      <TextBox x:Name="MaxWidthBox" Width="84" ToolTip="En büyük genişlik; 0 = sınırsız" core:ThemeAssist.Placeholder="Genişlik" />
                      <TextBlock Text="×" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0" />
                      <TextBox x:Name="MaxHeightBox" Width="84" ToolTip="En büyük yükseklik; 0 = sınırsız" core:ThemeAssist.Placeholder="Yükseklik" />
                    </StackPanel>
                    <TextBlock Text="En-boy oranı korunur, büyütme yapılmaz. 0 = sınırsız." Style="{StaticResource OptionHint}" />
                  </StackPanel>
                  <StackPanel x:Name="RowIcoSizes" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Simge boyutları (piksel)" Style="{StaticResource OptionLabel}" />
                    <WrapPanel x:Name="IcoSizesPanel">
                      <CheckBox Content="16" Tag="16" Style="{StaticResource FilterChip}" />
                      <CheckBox Content="24" Tag="24" Style="{StaticResource FilterChip}" />
                      <CheckBox Content="32" Tag="32" Style="{StaticResource FilterChip}" />
                      <CheckBox Content="48" Tag="48" Style="{StaticResource FilterChip}" />
                      <CheckBox Content="64" Tag="64" Style="{StaticResource FilterChip}" />
                      <CheckBox Content="128" Tag="128" Style="{StaticResource FilterChip}" />
                      <CheckBox Content="256" Tag="256" Style="{StaticResource FilterChip}" />
                    </WrapPanel>
                  </StackPanel>
                  <StackPanel x:Name="RowStrip" Style="{StaticResource OptionRow}">
                    <CheckBox x:Name="StripMetadataCheck" Style="{StaticResource ToggleSwitch}">
                      <StackPanel>
                        <TextBlock Text="Üstveriyi sil" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" />
                        <TextBlock Text="EXIF, konum ve kamera bilgisi çıkarılır" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                  <StackPanel x:Name="RowFit" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Sayfa boyutu" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="FitBox" Style="{StaticResource Segmented}" AutomationProperties.Name="Sayfa boyutu">
                      <ListBoxItem Content="A4'e sığdır" Tag="A4" />
                      <ListBoxItem Content="Görselin boyutu" Tag="Original" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowSplitMode" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Bölme biçimi" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="SplitModeBox" Style="{StaticResource Segmented}" SelectionChanged="OptionVisibilityChanged" AutomationProperties.Name="Bölme biçimi">
                      <ListBoxItem Content="Her sayfa ayrı" Tag="EachPage" />
                      <ListBoxItem Content="Aralıklara göre" Tag="Ranges" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowSplitRanges" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Aralıklar" Style="{StaticResource OptionLabel}" />
                    <TextBox x:Name="SplitRangesBox" core:ThemeAssist.Placeholder="Örn. 1-3, 4-6, 7" ToolTip="Virgülle ayrılan her aralık ayrı bir dosya olur. Örnek: 1-3,4-6,7" />
                    <TextBlock Text="Virgülle ayrılan her aralık ayrı bir dosya olur." Style="{StaticResource OptionHint}" />
                  </StackPanel>
                  <StackPanel x:Name="RowRotate" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Döndürme" Style="{StaticResource OptionLabel}" />
                    <ListBox x:Name="RotateBox" Style="{StaticResource Segmented}" AutomationProperties.Name="Döndürme">
                      <ListBoxItem Content="90° sağa" Tag="90" />
                      <ListBoxItem Content="180°" Tag="180" />
                      <ListBoxItem Content="90° sola" Tag="270" />
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="RowTemplate" Style="{StaticResource OptionRow}">
                    <TextBlock x:Name="TemplateLabel" Text="Dosya adı şablonu" Style="{StaticResource OptionLabel}" />
                    <TextBox x:Name="TemplateBox" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}"
                             ToolTip="{}{ad} kaynak adı · {sayfa} sayfa numarası · {sayfa:3} 001 gibi · {toplam} sayfa sayısı" />
                    <TextBlock Style="{StaticResource OptionHint}" Text="{}{ad} kaynak adı · {sayfa} sayfa no · {sayfa:3} 001 gibi · {toplam} sayfa sayısı" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel x:Name="RowOutName" Style="{StaticResource OptionRow}">
                    <TextBlock Text="Çıktı adı" Style="{StaticResource OptionLabel}" />
                    <TextBox x:Name="OutNameBox" core:ThemeAssist.Placeholder="Boş bırakırsan ilk dosyanın adı" ToolTip="Boş bırakırsan ilk dosyanın adı kullanılır" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="20,16,20,16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="Kayıt yeri" Style="{StaticResource SectionHeading}" Margin="0" />
                  </DockPanel>
                  <ListBox x:Name="LocationBox" Style="{StaticResource Segmented}" SelectionChanged="LocationChanged" AutomationProperties.Name="Kayıt yeri">
                    <ListBoxItem Content="Kaynağın yanına" Tag="NextToSource" />
                    <ListBoxItem Content="Seçtiğim klasöre" Tag="CustomFolder" />
                  </ListBox>
                  <DockPanel x:Name="FolderRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button Content="Seç" DockPanel.Dock="Right" core:ThemeAssist.Icon="&#xE838;" Click="ChooseFolder" Margin="8,0,0,0" ToolTip="Klasör seç" />
                    <TextBox x:Name="FolderBox" core:ThemeAssist.Placeholder="Çıktı klasörü" />
                  </DockPanel>
                  <TextBlock Text="Var olan dosyaların üzerine yazılmaz; ad doluysa “ad (2)” gibi yeni bir ad verilir." Style="{StaticResource OptionHint}"
                             Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <!-- Result of the last batch -->
            <Border x:Name="ResultCard" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="ResultIconTile" Style="{StaticResource IconTile}" Width="32" Height="32" VerticalAlignment="Top">
                    <TextBlock x:Name="ResultGlyph" Text="&#xE73E;" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultTitle" Text="Sonuç" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ResultSummary" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Click="CloseResults" VerticalAlignment="Top" Margin="0,-4,-6,0"
                          ToolTip="Kapat" AutomationProperties.Name="Sonucu kapat" />
                </Grid>
                <ScrollViewer x:Name="ResultScroll" MaxHeight="96" Margin="44,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <ItemsControl x:Name="ResultList" ItemTemplate="{StaticResource ResultRowTemplate}" Focusable="False" />
                </ScrollViewer>
                <Button x:Name="OpenFolderButton" Content="Klasörü aç" core:ThemeAssist.Icon="&#xE838;" Click="OpenResultFolder" HorizontalAlignment="Stretch"
                        Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <!-- Run -->
            <Border Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="{StaticResource FontSizeSmall}" LineHeight="18" Margin="0,0,0,10"
                           Visibility="Collapsed" />
                <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,12" Visibility="Collapsed" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="ConvertButton" Content="Dönüştür" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE8AB;" Click="OnConvert"
                          MinHeight="40" Margin="0" />
                  <Button x:Name="CancelButton" Grid.Column="1" Content="İptal" core:ThemeAssist.Icon="&#xE711;" Click="OnCancel" Visibility="Collapsed" MinHeight="40"
                          Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="RunSummary" Style="{StaticResource CaptionText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
