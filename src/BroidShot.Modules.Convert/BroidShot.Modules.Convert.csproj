<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BroidShot.Modules.Convert</RootNamespace>
    <AssemblyName>BroidShot.Modules.Convert</AssemblyName>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- PDFsharp (MIT): PDF merge/split/page edit and image embedding. The -wpf build reads WPF BitmapSource directly. -->
    <PackageReference Include="PDFsharp-wpf" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BroidShot.Core/BroidShot.Core.csproj" />
  </ItemGroup>
</Project>
