<UserControl x:Class="BroidShot.Modules.Utilities.SnippetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BroidShot.Modules.Utilities;component/Common/UtilityStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SnippetItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="14,9,12,9" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <!-- Inserts a placeholder token into the content box. -->
      <Style x:Key="TokenButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="core:ThemeAssist.CornerRadius" Value="13" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <!-- ===== List ===== -->
    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="14,14,14,10">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE710;" Click="NewSnippet" Margin="8,0,0,0" Padding="10,0"
                    MinWidth="34" ToolTip="Yeni şablon" AutomationProperties.Name="Yeni şablon" />
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" core:ThemeAssist.Placeholder="Şablon ara…" TextChanged="SearchChanged"
                     ToolTip="Ad, tetikleyici, klasör veya içerikte ara" AutomationProperties.Name="Şablon ara" />
          </DockPanel>
          <ComboBox x:Name="FolderFilter" SelectionChanged="FolderChanged" AutomationProperties.Name="Klasör" />
        </StackPanel>
        <ListBox x:Name="List" Grid.Row="1" Margin="8,0,8,8" ItemContainerStyle="{StaticResource SnippetItem}" SelectionChanged="SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Şablonlar">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel>
                  <Border x:Name="TriggerChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0" ToolTip="Tetikleyici kelime">
                    <TextBlock Text="{Binding Trigger}" FontFamily="{StaticResource MonoFont}" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Trigger}" Value="">
                  <Setter TargetName="TriggerChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyText" Grid.Row="1" Style="{StaticResource EmptyStatePanel}" Margin="20,0,20,40">
          <Border Style="{StaticResource EmptyStateIcon}" Width="52" Height="52" CornerRadius="14">
            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="20" />
          </Border>
          <TextBlock Text="Şablon yok" Style="{StaticResource EmptyStateTitle}" Margin="0,14,0,4" />
          <TextBlock Text="Sağdaki formu doldurup kaydet ya da aramayı değiştir." Style="{StaticResource EmptyStateText}" FontSize="13" />
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Background="{StaticResource ControlBrush}" CornerRadius="0,0,9,9" Padding="14,10">
          <StackPanel>
            <WrapPanel Style="{StaticResource HintRow}">
              <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl + K" /></Border>
              <TextBlock Text="→" VerticalAlignment="Center" Margin="6,0" />
              <TextBlock Text="Snippet: ad" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="Seçilen şablon önceki pencereye yapıştırılır." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===== Editor ===== -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="20,14,12,0">
          <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Sil" Style="{StaticResource DangerButton}" core:ThemeAssist.Icon="&#xE74D;" Click="DeleteSnippet" Margin="0"
                  ToolTip="Şablonu sil" />
          <TextBlock x:Name="EditorTitle" Text="Yeni şablon" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="20,14,20,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Ad" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="NameBox" core:ThemeAssist.Placeholder="Örn. E-posta imzası" AutomationProperties.Name="Ad" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Tetikleyici kelime" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="TriggerBox" FontFamily="{StaticResource MonoFont}" FontSize="13" core:ThemeAssist.Placeholder="örn. imza"
                       ToolTip="Komut paletinde bu kelimeyle de bulunur (isteğe bağlı)" AutomationProperties.Name="Tetikleyici kelime" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Klasör" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="FolderBox" core:ThemeAssist.Placeholder="örn. İş" AutomationProperties.Name="Klasör" />
            </StackPanel>
          </Grid>

          <TextBlock Grid.Row="1" Text="İçerik" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="ContentBox" Grid.Row="2" Style="{StaticResource CodeTextBox}" FontFamily="{StaticResource UiFont}" FontSize="14" TextWrapping="Wrap"
                   HorizontalScrollBarVisibility="Disabled" TextChanged="ContentChanged" core:ThemeAssist.Placeholder="Kaydedilecek metin…" AutomationProperties.Name="İçerik" />

          <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Ekle:" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Content="{}{tarih}" Tag="{}{tarih}" Style="{StaticResource TokenButton}" Click="InsertToken" ToolTip="Bugünün tarihi (gg.aa.yyyy). Biçim verilebilir: {tarih:yyyy-MM-dd}" />
            <Button Content="{}{saat}" Tag="{}{saat}" Style="{StaticResource TokenButton}" Click="InsertToken" ToolTip="Şu anki saat (ss:dd)" />
            <Button Content="{}{pano}" Tag="{}{pano}" Style="{StaticResource TokenButton}" Click="InsertToken" ToolTip="Panodaki metin" />
            <TextBlock Text="Biçim de verilebilir: {tarih:yyyy-MM-dd}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,0,0" />
          </WrapPanel>

          <TextBlock Grid.Row="4" Text="Önizleme" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
          <Border Grid.Row="5" Style="{StaticResource InsetPanel}" Padding="12,10" MinHeight="44">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
          </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="20,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Panoya kopyala" core:ThemeAssist.Icon="&#xE8C8;" Click="CopySnippet" />
              <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE74E;" Click="SaveSnippet" Margin="0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,0,16,0" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
