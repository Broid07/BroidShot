<UserControl x:Class="BroidShot.Modules.Utilities.TextToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BroidShot.Modules.Utilities;component/Common/UtilityStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Operation button of the selected group (created in code). -->
      <Style x:Key="OperationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>
      <Style x:Key="PaneHeader" TargetType="Border">
        <Setter Property="Padding" Value="16,0,8,0" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>
      <Style x:Key="PaneFooter" TargetType="Border">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="46" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
      </Style>
      <!-- Code box filling a pane (no own border; the card draws it). -->
      <Style x:Key="PaneTextBox" TargetType="TextBox" BasedOn="{StaticResource CodeTextBox}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="core:ThemeAssist.CornerRadius" Value="0,0,9,9" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Operation picker: group chips, then the group's operations ===== -->
    <Border Style="{StaticResource Card}" Padding="16,14,16,8" Margin="0,0,0,16">
      <StackPanel>
        <WrapPanel x:Name="GroupPanel" Margin="0,0,0,8" />
        <Border Style="{StaticResource Divider}" Margin="0,2,0,12" />
        <WrapPanel x:Name="OperationPanel" />
      </StackPanel>
    </Border>

    <!-- ===== Input / output ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource PaneHeader}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE77F;" Click="PasteInput" ToolTip="Panodan yapıştır" AutomationProperties.Name="Panodan yapıştır" />
                <Button Style="{StaticResource IconButton}" Content="&#xE75C;" Click="ClearAll" ToolTip="Temizle" AutomationProperties.Name="Temizle" />
              </StackPanel>
              <TextBlock Text="Girdi" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource PaneTextBox}" TextChanged="InputChanged" core:ThemeAssist.Placeholder="Metni buraya yaz veya yapıştır…"
                   AutomationProperties.Name="Girdi" />
          <Border Grid.Row="2" Style="{StaticResource PaneFooter}">
            <TextBlock x:Name="StatsText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource PaneHeader}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" Click="MoveToInput" ToolTip="Çıktıyı girdiye taşı" AutomationProperties.Name="Çıktıyı girdiye taşı" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="CopyOutput" ToolTip="Kopyala" AutomationProperties.Name="Çıktıyı kopyala" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Çıktı" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="LastOperationChip" Style="{StaticResource AccentChip}" Margin="10,0,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="LastOperationText" />
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource ErrorBar}" Margin="12,12,12,0" Visibility="{Binding Visibility, ElementName=ErrorText}">
            <DockPanel>
              <TextBlock Text="&#xEB90;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
              <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" LineHeight="19" Visibility="Collapsed" />
            </DockPanel>
          </Border>
          <TextBox x:Name="OutputBox" Grid.Row="2" Style="{StaticResource PaneTextBox}" IsReadOnly="True" core:ThemeAssist.Placeholder="Bir işlem seçince sonuç burada görünür."
                   AutomationProperties.Name="Çıktı" />
          <Border Grid.Row="3" Style="{StaticResource PaneFooter}" Padding="16,0,8,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Kopyala" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xE8C8;" Click="CopyOutput" Margin="0"
                      MinHeight="30" Padding="12,0" VerticalAlignment="Center" />
              <TextBlock x:Name="OutputStats" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
