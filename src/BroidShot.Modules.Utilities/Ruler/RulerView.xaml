<UserControl x:Class="BroidShot.Modules.Utilities.RulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BroidShot.Modules.Utilities;component/Common/UtilityStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ShortcutText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
      </Style>
      <Style x:Key="ShortcutKey" TargetType="Border" BasedOn="{StaticResource Keycap}">
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== Start ===== -->
      <Border Style="{StaticResource Card}" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Border Style="{StaticResource AccentIconTile}" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
              <TextBlock Text="&#xED5E;" Style="{StaticResource IconText}" FontSize="18" />
            </Border>
            <StackPanel>
              <TextBlock Text="Ekranda ölç" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource MutedText}" FontSize="13" LineHeight="19"
                         Text="Ekran donar ve kararır. Sürükleyerek genişlik, yükseklik ve çapraz uzunluğu fiziksel piksel olarak ölç; ölçekli ekranlarda dp karşılığı da yazılır." />
            </StackPanel>
          </DockPanel>

          <!-- Shortcuts on the ruler screen. -->
          <Grid Grid.Row="1" Margin="54,16,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="64" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Sürükle" /></Border>
            <TextBlock Grid.Column="1" Text="iki nokta arasını ölç" Style="{StaticResource ShortcutText}" />
            <Border Grid.Row="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Shift" /></Border>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="tam yatay veya dikey kilitle" Style="{StaticResource ShortcutText}" />
            <Border Grid.Row="2" Style="{StaticResource ShortcutKey}"><TextBlock Text="Enter" /></Border>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="ölçüyü panoya kopyala ve kapat" Style="{StaticResource ShortcutText}" />
            <Border Grid.Row="3" Style="{StaticResource ShortcutKey}"><TextBlock Text="Esc" /></Border>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="kapat" Style="{StaticResource ShortcutText}" />
          </Grid>

          <Button Grid.Row="2" x:Name="StartButton" Content="Cetveli başlat" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xED5E;"
                  HorizontalAlignment="Left" Margin="54,0,0,0" Click="Start" />
        </Grid>
      </Border>

      <!-- ===== Last measurement ===== -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="SON ÖLÇÜM" Style="{StaticResource SectionLabel}" />

          <StackPanel x:Name="LastPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="LastSize" Text="300 × 200" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal"
                         Foreground="{StaticResource TextBrush}" VerticalAlignment="Bottom" />
              <TextBlock Text="px" FontSize="{StaticResource FontSizeBodyLarge}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Style="{StaticResource AccentChip}">
                <TextBlock x:Name="LastDiagonal" Text="çapraz 360.56 px" />
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="LastEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,8,0,8" Visibility="Collapsed">
            <TextBlock Text="Henüz ölçüm yok" Style="{StaticResource BodyStrongText}" />
            <TextBlock Text="Cetveli başlatıp Enter'a bastığında ölçü burada görünür ve panoya kopyalanır." Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" />
          </StackPanel>

          <Button x:Name="CopyLastButton" Grid.Row="2" Content="Kopyala" Style="{StaticResource SecondaryButton}" core:ThemeAssist.Icon="&#xE8C8;"
                  HorizontalAlignment="Left" Click="CopyLast" />
        </Grid>
      </Border>
    </Grid>

    <!-- Built into the capture overlay too. -->
    <WrapPanel Style="{StaticResource HintRow}" Margin="2,0,0,28" AutomationProperties.Name="Alan seçim ekranında M tuşu cetveli açar">
      <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
      <TextBlock Text="Alan seçerken de kullanılabilir:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="M" /></Border>
      <TextBlock Text="cetvel  ·  seçimin boyutu da çerçevenin üstünde yazar." VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
    </WrapPanel>

    <!-- ===== Recent ===== -->
    <DockPanel Margin="0,0,0,12">
      <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Listeyi temizle" Style="{StaticResource GhostButton}" core:ThemeAssist.Icon="&#xE74D;" Click="Clear" Margin="0" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Son ölçümler" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center" />
        <Border Style="{StaticResource Chip}" Margin="10,1,0,0">
          <TextBlock x:Name="RecentCount" Text="0 / 10" />
        </Border>
      </StackPanel>
    </DockPanel>
    <Border Style="{StaticResource SettingsCard}">
      <Grid>
        <TextBlock x:Name="EmptyText" Text="Henüz ölçüm yok." Style="{StaticResource MutedText}" Margin="20,16" />
        <ItemsControl x:Name="RecentList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Row" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,0,12,0" MinHeight="48">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="CopyRow" VerticalAlignment="Center"
                          ToolTip="Panoya kopyala" AutomationProperties.Name="Ölçüyü panoya kopyala" />
                  <TextBlock Text="&#xED5E;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,14,0" />
                  <TextBlock Text="{Binding Size}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" MinWidth="130" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                  <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
