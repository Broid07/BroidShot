<UserControl x:Class="BroidShot.Modules.Utilities.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BroidShot.Core;assembly=BroidShot.Core">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BroidShot.Modules.Utilities;component/Common/UtilityStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- One copyable format row of the current colour (DataContext = ColorHistoryItem). -->
      <Style x:Key="FormatName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="FormatValue" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="FormatRow" TargetType="Border">
        <Setter Property="Padding" Value="14,0,6,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">

    <!-- ===== Current colour ===== -->
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14">
      <StackPanel>
        <Grid Margin="20,20,20,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Big swatch (or an empty well before the first pick). -->
          <Grid Height="206" VerticalAlignment="Top">
            <Border x:Name="NoColorSwatch" CornerRadius="10" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xEF3C;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBlock Text="Henüz renk yok" Style="{StaticResource CaptionText}" Margin="0,10,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border x:Name="CurrentSwatch" CornerRadius="10" Background="{Binding Swatch}" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1"
                    Visibility="Collapsed" ToolTip="{Binding Hex}" />
          </Grid>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="RemoveCurrentButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="RemoveItem" VerticalAlignment="Top"
                      ToolTip="Geçmişten sil" AutomationProperties.Name="Rengi geçmişten sil" />
              <StackPanel>
                <TextBlock Text="SEÇİLİ RENK" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                <TextBlock x:Name="CurrentHex" Text="{Binding Hex, FallbackValue='—'}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource TextBrush}" />
              </StackPanel>
            </DockPanel>

            <!-- Formats with copy buttons. Tag = ColorFormat name read by CopyFormat. -->
            <Border x:Name="FormatTable" Grid.Row="1" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Border Style="{StaticResource FormatRow}" BorderThickness="0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Tag="Hex" Click="CopyFormat" ToolTip="HEX olarak kopyala" AutomationProperties.Name="HEX olarak kopyala" />
                    <TextBlock Text="HEX" Style="{StaticResource FormatName}" Width="64" />
                    <TextBlock Text="{Binding Hex, FallbackValue='—'}" Style="{StaticResource FormatValue}" />
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource FormatRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Tag="Rgb" Click="CopyFormat" ToolTip="RGB olarak kopyala" AutomationProperties.Name="RGB olarak kopyala" />
                    <TextBlock Text="RGB" Style="{StaticResource FormatName}" Width="64" />
                    <TextBlock Text="{Binding RgbText, FallbackValue='—'}" Style="{StaticResource FormatValue}" />
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource FormatRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Tag="Hsl" Click="CopyFormat" ToolTip="HSL olarak kopyala" AutomationProperties.Name="HSL olarak kopyala" />
                    <TextBlock Text="HSL" Style="{StaticResource FormatName}" Width="64" />
                    <TextBlock Text="{Binding HslText, FallbackValue='—'}" Style="{StaticResource FormatValue}" />
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource FormatRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Tag="CSharp" Click="CopyFormat" ToolTip="C# Color olarak kopyala" AutomationProperties.Name="C# Color olarak kopyala" />
                    <TextBlock Text="C#" Style="{StaticResource FormatName}" Width="64" />
                    <TextBlock Text="{Binding CSharpText, FallbackValue='—'}" Style="{StaticResource FormatValue}" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Action strip: pick from screen, hotkey, default copy format. -->
        <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" Padding="20,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Seçince kopyala:" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ComboBox x:Name="FormatBox" Width="140" VerticalAlignment="Center" SelectionChanged="FormatChanged" AutomationProperties.Name="Varsayılan kopyalama biçimi" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Ekrandan renk al" Style="{StaticResource PrimaryButton}" core:ThemeAssist.Icon="&#xEF3C;" Click="Pick" Margin="0,0,14,0" />
              <Border Style="{StaticResource Keycap}">
                <TextBlock x:Name="HotkeyLabel" Text="Ctrl + Shift + C" />
              </Border>
              <TextBlock x:Name="HotkeyText" Text="her yerden" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Built into the capture overlay too. -->
    <WrapPanel Style="{StaticResource HintRow}" Margin="2,0,0,28" AutomationProperties.Name="Alan seçim ekranında I tuşu renk seçiciyi açar">
      <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
      <TextBlock Text="Alan seçerken de kullanılabilir:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Border Style="{StaticResource Keycap}"><TextBlock Text="I" /></Border>
      <TextBlock Text="renk seçici  ·  tık HEX, Shift RGB, Ctrl HSL kopyalar; seçilen renkler bu geçmişe eklenir." VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
    </WrapPanel>

    <!-- ===== History ===== -->
    <DockPanel Margin="0,0,0,12">
      <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right" Content="Geçmişi temizle" Style="{StaticResource GhostButton}" core:ThemeAssist.Icon="&#xE74D;" Click="ClearHistory" Margin="0" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="HistoryTitle" Text="Renk geçmişi" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center" />
        <Border Style="{StaticResource Chip}" Margin="10,1,0,0">
          <TextBlock x:Name="HistoryCount" Text="0 / 50" />
        </Border>
      </StackPanel>
    </DockPanel>
    <Border Style="{StaticResource Card}" Padding="16,16,8,8">
      <Grid>
        <TextBlock x:Name="EmptyText" Text="Henüz renk seçilmedi. Ekrandan aldığın renkler burada birikir; birine tıklayınca yukarıda açılır, çift tıklayınca kopyalanır."
                   Style="{StaticResource MutedText}" Margin="4,4,8,12" />
        <ListBox x:Name="HistoryList" ItemContainerStyle="{StaticResource SwatchItem}" SelectionChanged="HistorySelectionChanged" MouseDoubleClick="HistoryDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Renk geçmişi">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="40" Height="40" CornerRadius="7" Background="{Binding Swatch}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                      ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
