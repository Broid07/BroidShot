<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../../src/BroidShot/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BroidShot/BroidShot.csproj"/>
    <!-- The sample module is not shipped; the shell test still drives it as a known module. -->
    <ProjectReference Include="../../src/BroidShot.Modules.Sample/BroidShot.Modules.Sample.csproj"/>
  </ItemGroup>
</Project>
