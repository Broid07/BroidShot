<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/BroidShot/Lifecycle/*.cs" Link="Lifecycle/%(Filename)%(Extension)"/>
    <Compile Include="../../src/BroidShot/UserPreferences.cs" Link="UserPreferences.cs"/>
    <Compile Include="../../src/BroidShot/DataPaths.cs" Link="DataPaths.cs"/>
    <ProjectReference Include="../../src/BroidShot.Core/BroidShot.Core.csproj"/>
  </ItemGroup>
</Project>
